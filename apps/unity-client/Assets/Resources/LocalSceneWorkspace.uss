.workspace { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(34, 48, 65); font-size: 18px; }
.row { flex-direction: row; flex-wrap: wrap; }
.header { min-height: 60px; padding: 8px 16px; background-color: rgb(248, 250, 253); align-items: center; justify-content: space-between; }
.header > Label { font-size: 22px; -unity-font-style: bold; }
.main { flex-grow: 1; min-height: 0; flex-wrap: nowrap; }
.library { width: 240px; flex-shrink: 0; padding: 12px; background-color: rgb(248, 250, 253); }
.right { flex-grow: 1; min-width: 0; }
.preview { flex-grow: 1; min-height: 180px; }
.preview-hint { margin: 12px; white-space: normal; font-size: 16px; }
.editor-scroll { flex-grow: 1; flex-basis: 55%; min-height: 240px; background-color: rgb(255, 255, 255); padding: 12px; }
.library-list { flex-grow: 1; min-height: 100px; }
.summary { white-space: normal; margin-bottom: 8px; }
Button { min-height: 44px; min-width: 90px; margin: 4px; padding: 6px 10px; white-space: normal; border-radius: 6px; background-color: rgb(229, 238, 249); color: rgb(34, 65, 95); border-width: 0; }
Button:hover { background-color: rgb(205, 223, 245); }
Button:disabled { opacity: 0.5; }
TextField { margin: 4px; min-height: 44px; flex-grow: 1; }
TextField > Label { min-width: 84px; }
.unity-text-input { min-height: 36px; padding: 6px; font-size: 18px; }
.json { height: 220px; }
.json .unity-text-input { white-space: normal; }
.room-fields { max-height: 180px; margin: 4px; }
.history-list { max-height: 200px; }
.status { min-height: 54px; padding: 12px 16px; white-space: normal; background-color: rgb(239, 245, 252); }
.modal-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.confirm { width: 420px; max-width: 95%; padding: 20px; background-color: rgb(255, 255, 255); border-width: 2px; border-color: rgb(57, 100, 150); border-radius: 8px; }
.confirm > Label { white-space: normal; margin-bottom: 12px; }
